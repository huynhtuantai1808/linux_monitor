# ============================================================
# Linux Monitor - Cấu hình kênh cảnh báo
# Sao chép file này thành .env và điền thông tin thực tế
# ============================================================

# Kênh thông báo muốn sử dụng: telegram | viber | office365
NOTIFY_CHANNEL=telegram

# --- Telegram ---
# 1. Tìm @BotFather trên Telegram, tạo bot mới
# 2. Lấy Bot Token từ BotFather
# 3. Gửi 1 tin nhắn cho bot, sau đó truy cập:
#    https://api.telegram.org/bot<TOKEN>/getUpdates để lấy chat_id
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# --- Viber ---
# Tạo Viber Bot tại: https://partners.viber.com
# Lấy AUTH_TOKEN từ dashboard
VIBER_AUTH_TOKEN=your_viber_auth_token_here
VIBER_RECEIVER_ID=your_viber_receiver_id_here
VIBER_BOT_NAME=Linux Monitor

# --- Email Office 365 ---
# Dùng tài khoản Microsoft 365 Business / Personal
O365_USER=your_account@company.com
O365_PASS=your_email_password_or_app_password
MAIL_TO=alert_recipient@company.com
MAIL_FROM=your_account@company.com

# --- Master Server Config ---
# Host và Port master lắng nghe - Để 0.0.0.0 để nhận từ mọi IP
MASTER_HOST=0.0.0.0
MASTER_PORT=8000

# --- Agent Config (điền vào file .env ở phía Agent) ---
# MASTER_URL=http://<IP_CUA_MASTER>:8000/metrics
# INTERVAL=60
