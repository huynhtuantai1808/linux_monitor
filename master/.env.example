# ============================================================
# Master Server .env - Điền thông tin thực tế vào đây
# NOTIFY_CHANNEL: telegram | gmail | office365 | viber | all
# ============================================================
NOTIFY_CHANNEL=telegram

# --- Telegram ---
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# --- Viber ---
VIBER_AUTH_TOKEN=
VIBER_RECEIVER_ID=
VIBER_BOT_NAME=Linux Monitor

# --- Gmail (dùng App Password, KHÔNG dùng mật khẩu thường) ---
# Tạo App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
GMAIL_TO=recipient@gmail.com

# --- Office 365 ---
O365_USER=
O365_PASS=
MAIL_TO=
MAIL_FROM=

# --- Master Server ---
MASTER_HOST=0.0.0.0
MASTER_PORT=8000
