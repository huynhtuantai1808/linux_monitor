# ============================================================
# Master Server .env - Điền thông tin thực tế vào đây
# ============================================================

# NOTIFY_CHANNELS: Liệt kê các kênh cách nhau bởi dấu phẩy
# Hợp lệ: telegram | gmail | office365 | viber
# Ví dụ một kênh:  NOTIFY_CHANNELS=telegram
# Ví dụ nhiều kênh: NOTIFY_CHANNELS=telegram,gmail
# Ví dụ tất cả:    NOTIFY_CHANNELS=telegram,gmail,office365,viber
NOTIFY_CHANNELS=telegram,gmail

# --- Telegram ---
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# --- Viber ---
VIBER_AUTH_TOKEN=
VIBER_RECEIVER_ID=
VIBER_BOT_NAME=Linux Monitor

# --- Gmail (App Password 16 ký tự) ---
# Tạo tại: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
GMAIL_TO=admin@gmail.com,ops@company.com

# --- Office 365 ---
O365_USER=
O365_PASS=
MAIL_TO=
MAIL_FROM=

# --- Master Server ---
MASTER_HOST=0.0.0.0
MASTER_PORT=8000
